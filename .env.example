# Firebase config (optional).
# If these are NOT set, the app runs in "mock" mode with a local,
# localStorage-persisted backend seeded with demo data (see seed).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The user id used for the mock local backend.
VITE_MOCK_USER_ID=dev-user
