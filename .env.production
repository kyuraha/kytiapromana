# Production build config.
#
# Vite loads this file when building in production mode. The current Firebase
# web client config is committed so the deployed build (Cloudflare Pages, etc.)
# connects to the live Firestore/Auth project — .env is gitignored so it can't
# be read by the cloud build. Firebase web client keys are public by design
# (they ship in the browser); real security comes from Firestore rules + Auth.
#
# If you prefer, you can instead set these as environment variables in your
# host's build settings (e.g. Cloudflare Pages → Settings → Environment
# variables) and delete this file.
VITE_FIREBASE_API_KEY=AIzaSyAH6NXiQuTOKwU0ExP2aN-Cco7ojf4Rzg0
VITE_FIREBASE_AUTH_DOMAIN=kytia-promana.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kytia-promana
VITE_FIREBASE_STORAGE_BUCKET=kytia-promana.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=847586171368
VITE_FIREBASE_APP_ID=1:847586171368:web:f11eb535a4d0ffab5fec5d
VITE_FIREBASE_MEASUREMENT_ID=G-B2KG9NCPB5
